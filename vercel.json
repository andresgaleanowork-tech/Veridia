{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --filter veridia-app... --frozen-lockfile",
  "buildCommand": "pnpm --filter veridia-app build",
  "outputDirectory": "apps/frontend/dist",
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/api/(.*)",
      "dest": "${VERIDIA_API_URL}/api/$1",
      "env": ["VERIDIA_API_URL"]
    },
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": { "cache-control": "no-cache" },
      "dest": "/index.html"
    }
  ]
}
