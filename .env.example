# Database
# Generate a URL-safe password (it is embedded in DATABASE_URL):
#   openssl rand -hex 24
DB_PASSWORD=

# JWT
# Generate a separate strong secret for each one:
#   openssl rand -base64 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# External APIs
USDA_API_KEY=DEMO_KEY
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# Stripe (production keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Firebase
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# CORS (production origins)
CORS_ORIGIN=https://veridia.tech,https://app.veridia.tech

# Node
NODE_ENV=production
PORT=3456
