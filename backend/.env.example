PORT=3456
NODE_ENV=development
DATABASE_URL=postgresql://nutrisuite:nutrisuite_secret@localhost:5432/nutrisuite_db
JWT_SECRET=nutrisuite_jwt_secret_change_in_production
JWT_REFRESH_SECRET=nutrisuite_refresh_change_in_production
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
USDA_API_KEY=DEMO_KEY
GEMINI_API_KEY=
CORS_ORIGIN=https://veridia.health,https://app.veridia.health
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Security hardening
CSRF_SECRET=generate-32-char-secret-for-production
REDIS_URL=redis://localhost:6379
HELMET_CSP_REPORT_URI=/api/security/csp-report
