{
  "name": "veridia-monorepo",
  "private": true,
  "version": "5.3.0",
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev": "concurrently \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "db:push": "pnpm --filter backend db:push",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:studio": "pnpm --filter backend db:studio",
    "db:seed": "pnpm --filter backend db:seed",
    "db:generate": "pnpm --filter backend db:generate",
    "types:sync": "pnpm --filter backend types:export",
    "build": "pnpm --filter frontend build && pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "lint": "pnpm --filter frontend lint && pnpm --filter backend lint",
    "test": "pnpm --filter frontend test:run && pnpm --filter backend test",
    "test:frontend": "pnpm --filter frontend test:run",
    "test:backend": "pnpm --filter backend test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "pnpm": "^9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@sulesky/opencode-plugger": "^0.1.4",
    "@sulesky/opencode-plugger-tui": "^0.1.4"
  }
}