<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Helvetica Neue', Arial, sans-serif; color: #1e293b; font-size: 11px; line-height: 1.5; }
    .header { display: flex; justify-content: space-between; align-items: center; padding-bottom: 15px; border-bottom: 2px solid {{branding.primaryColor}}; margin-bottom: 20px; }
    .logo { max-height: 60px; }
    .clinic-info { text-align: right; font-size: 10px; color: #64748b; }
    .clinic-name { font-size: 14px; font-weight: 700; color: #0f172a; }
    .title { font-size: 18px; font-weight: 700; color: {{branding.primaryColor}}; margin: 15px 0 10px; text-transform: uppercase; letter-spacing: 1px; }
    .section { margin-bottom: 20px; }
    .section-title { font-size: 13px; font-weight: 700; color: {{branding.primaryColor}}; margin-bottom: 8px; padding-bottom: 4px; border-bottom: 1px solid #e2e8f0; }
    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 15px; }
    .info-item { padding: 6px 10px; background: #f8fafc; border-radius: 4px; }
    .info-item label { font-size: 9px; color: #64748b; text-transform: uppercase; display: block; }
    .info-item span { font-size: 12px; font-weight: 600; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
    th { background: #f1f5f9; padding: 6px 8px; text-align: left; font-size: 9px; color: #64748b; text-transform: uppercase; }
    td { padding: 6px 8px; border-bottom: 1px solid #f1f5f9; font-size: 10px; }
    .alert-critica { color: #dc2626; font-weight: 700; }
    .alert-grave { color: #ea580c; font-weight: 600; }
    .alert-moderada { color: #d97706; }
    .footer { margin-top: 30px; padding-top: 15px; border-top: 1px solid #e2e8f0; display: flex; justify-content: space-between; font-size: 9px; color: #94a3b8; }
    .professional { text-align: right; }
    .professional strong { color: #1e293b; }
  </style>
</head>
<body>
  <div class="header">
    {{#if branding.logo}}<img src="{{branding.logo}}" class="logo" />{{/if}}
    <div class="clinic-info">
      {{#if branding.clinicName}}<div class="clinic-name">{{branding.clinicName}}</div>{{/if}}
      {{#if branding.clinicAddress}}<div>{{branding.clinicAddress}}</div>{{/if}}
      {{#if branding.clinicPhone}}<div>{{branding.clinicPhone}}</div>{{/if}}
    </div>
  </div>

  <div class="title">Reporte Clínico</div>

  <div class="section">
    <div class="section-title">Datos del Paciente</div>
    <div class="info-grid">
      <div class="info-item"><label>Nombre</label><span>{{patient.name}}</span></div>
      <div class="info-item"><label>DNI</label><span>{{patient.dni}}</span></div>
      <div class="info-item"><label>Fecha de Nacimiento</label><span>{{patient.birthDate}}</span></div>
      <div class="info-item"><label>Sexo</label><span>{{patient.sex}}</span></div>
      <div class="info-item"><label>Grupo Sanguíneo</label><span>{{patient.bloodType}}</span></div>
      <div class="info-item"><label>Fecha del Reporte</label><span>{{date}}</span></div>
    </div>
  </div>

  {{#if history}}
  <div class="section">
    <div class="section-title">Historia Clínica</div>
    {{#if history.antecedentes}}<p><strong>Antecedentes:</strong> {{history.antecedentes}}</p>{{/if}}
    {{#if history.alergias}}<p><strong>Alergias:</strong> {{history.alergias}}</p>{{/if}}
    {{#if history.medicacion}}<p><strong>Medicación:</strong> {{history.medicacion}}</p>{{/if}}
    {{#if history.suplementacion}}<p><strong>Suplementación:</strong> {{history.suplementacion}}</p>{{/if}}
    {{#if history.habitos_toxicos}}<p><strong>Hábitos tóxicos:</strong> {{history.habitos_toxicos}}</p>{{/if}}
    {{#if history.actividad_fisica}}<p><strong>Actividad física:</strong> {{history.actividad_fisica}}</p>{{/if}}
  </div>
  {{/if}}

  {{#if analytics.length}}
  <div class="section">
    <div class="section-title">Marcadores Biológicos</div>
    <table>
      <thead><tr><th>Marcador</th><th>Valor</th><th>Referencia</th><th>Estado</th></tr></thead>
      <tbody>
        {{#each analytics as |a|}}
        <tr>
          <td>{{a.nombre}}</td>
          <td>{{a.valor}} {{a.unidad}}</td>
          <td>{{a.referencia_min}} - {{a.referencia_max}}</td>
          <td>{{a.estado}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{/if}}

  {{#if alerts.length}}
  <div class="section">
    <div class="section-title">Alertas Activas</div>
    <table>
      <thead><tr><th>Tipo</th><th>Severidad</th><th>Mensaje</th></tr></thead>
      <tbody>
        {{#each alerts as |alert|}}
        <tr>
          <td>{{alert.tipo}}</td>
          <td class="alert-{{alert.severidad}}">{{alert.severidad}}</td>
          <td>{{alert.mensaje}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{/if}}

  <div class="footer">
    <div>Documento generado por Veridia HealthTech</div>
    <div class="professional">
      <strong>{{professional.name}}</strong><br>
      {{professional.title}}<br>
      {{professional.license}}
    </div>
  </div>
</body>
</html>
