{
  "name": "@veridia/backend",
  "version": "5.3.0",
  "description": "Veridia HealthTech V5.3 \u2014 Backend API REST para ERP Cl\u00ednico Nutricional",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/utils/seed.ts",
    "seed:bedca": "tsx src/utils/seed-bedca.ts",
    "types:export": "drizzle-kit generate --typescript && cp -r drizzle/types/* ../../packages/shared-types/src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "csrf": "^3.1.0",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.5.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.4",
    "firebase-admin": "^14.2.0",
    "handlebars": "^4.7.9",
    "helmet": "^7.1.0",
    "ics": "^3.12.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "postgres": "^3.4.0",
    "puppeteer": "^25.8.0",
    "stripe": "^22.5.0",
    "twilio": "^6.1.0",
    "uuid": "^9.0.0",
    "winston": "^3.19.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.56.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11"
  },
  "author": "Andr\u00e9s Galeano",
  "license": "MIT"
}
