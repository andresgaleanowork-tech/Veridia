{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter veridia-app build",
  "outputDirectory": "dist",
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/api/(.*)",
      "dest": "${VERIDIA_API_URL}/api/$1",
      "env": ["VERIDIA_API_URL"]
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
